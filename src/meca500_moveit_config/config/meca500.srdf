<?xml version="1.0" encoding="UTF-8"?>
<robot name="helico_bench">

    <!-- ========================================================= -->
    <!-- MoveIt planning group                                     -->
    <!-- ========================================================= -->

    <group name="meca_arm">
        <chain base_link="base_link" tip_link="link_6"/>
    </group>


    <!-- ========================================================= -->
    <!-- Named robot states                                        -->
    <!-- ========================================================= -->

    <group_state name="home" group="meca_arm">
        <joint name="meca_axis_1" value="0"/>
        <joint name="meca_axis_2" value="0"/>
        <joint name="meca_axis_3" value="0"/>
        <joint name="meca_axis_4" value="0"/>
        <joint name="meca_axis_5" value="0"/>
        <joint name="meca_axis_6" value="0"/>
    </group_state>


    <!-- ========================================================= -->
    <!-- Meca500 self-collision exclusions                         -->
    <!--                                                          -->
    <!-- Adjacent: links are physically connected                  -->
    <!-- Never: validated robot link pairs which cannot collide    -->
    <!-- during normal robot motion                                -->
    <!-- ========================================================= -->

    <disable_collisions
        link1="base_link"
        link2="link_1"
        reason="Adjacent"/>

    <disable_collisions
        link1="base_link"
        link2="link_2"
        reason="Never"/>

    <disable_collisions
        link1="link_1"
        link2="link_2"
        reason="Adjacent"/>

    <disable_collisions
        link1="link_1"
        link2="link_3"
        reason="Never"/>

    <disable_collisions
        link1="link_2"
        link2="link_3"
        reason="Adjacent"/>

    <disable_collisions
        link1="link_3"
        link2="link_4"
        reason="Adjacent"/>

    <disable_collisions
        link1="link_3"
        link2="link_5"
        reason="Never"/>

    <disable_collisions
        link1="link_3"
        link2="link_6"
        reason="Never"/>

    <disable_collisions
        link1="link_4"
        link2="link_5"
        reason="Adjacent"/>

    <disable_collisions
        link1="link_4"
        link2="link_6"
        reason="Never"/>

    <disable_collisions
        link1="link_5"
        link2="link_6"
        reason="Adjacent"/>


    <!-- ========================================================= -->
    <!-- Link 6 measurement tool                                  -->
    <!--                                                          -->
    <!-- These components form one rigid physical assembly.        -->
    <!-- Collision checking between directly mounted neighbours    -->
    <!-- is therefore disabled.                                   -->
    <!--                                                          -->
    <!-- IMPORTANT: collisions between tooling and the Planning    -->
    <!-- Scene environment remain ENABLED.                         -->
    <!-- ========================================================= -->

    <disable_collisions
        link1="link_6"
        link2="tools_mount"
        reason="Adjacent"/>

    <disable_collisions
        link1="tools_mount"
        link2="laser_sensor_mount"
        reason="Adjacent"/>

    <disable_collisions
        link1="laser_sensor_mount"
        link2="laser_sensor"
        reason="Adjacent"/>

    <disable_collisions
        link1="tools_mount"
        link2="force_sensor"
        reason="Adjacent"/>

    <disable_collisions
        link1="force_sensor"
        link2="force_poker"
        reason="Adjacent"/>

    <disable_collisions
        link1="tools_mount"
        link2="april_tag_mount"
        reason="Adjacent"/>

</robot>